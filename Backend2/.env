PORT=3000
NODE_ENV=development

# ZegoCloud Credentials (from ZegoCloud Console)
ZEGO_APP_ID=your_app_id_here
ZEGO_SERVER_SECRET=your_server_secret_here

# Token expiry in seconds (default 1 hour)
ZEGO_TOKEN_EXPIRE=3600

# Comma-separated list of allowed origins (leave blank or * to allow all)
ALLOWED_ORIGINS=*
